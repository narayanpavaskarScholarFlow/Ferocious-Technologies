rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * TOOLROOM2.0 Security Rules
     * 
     * Core Philosophy: 
     * This ruleset implements a hybrid security model combining strict Path-Based Ownership 
     * for user profiles and Marker-Based Administrative Access (DBAC) for system-wide 
     * configurations and the tool catalog.
     * 
     * Data Structure:
     * - /user_profiles/{userId}: Private user data, keyed by Firebase Auth UID.
     * - /categories/{categoryId} & /tags/{tagId}: Global system metadata.
     * - /tools/{toolId}: A global catalog of resources.
     * - /roles_admin/{userId}: A restricted collection used to identify administrator accounts.
     * 
     * Key Security Decisions:
     * - Authorization Independence: Critical fields like 'ownerId' are denormalized onto 
     *   Tool documents to allow for atomic write validation without cross-document lookups.
     * - DBAC (Database Access Control): Administrative rights are granted via the existence 
     *   of a document in the 'roles_admin' collection, checked via the `exists()` function.
     * - QAP Compliance: Read rules allow broad access (list) where appropriate (catalog/metadata) 
     *   while write rules strictly enforce identity and role requirements.
     * - Relational Integrity: On creation of user-scoped data, the rules enforce that the 
     *   internal ID field matches the document path ID.
     */

    // --- Helper Functions ---

    /** Checks if the request is from a signed-in user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user's UID matches the provided userId (Path-based). */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the authenticated user has a marker in the roles_admin collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** Validates that the user is the owner of the existing document in the resource. */
    function isExistingOwner(ownerId) {
      return isSignedIn() && resource != null && request.auth.uid == ownerId;
    }

    /** Validates that the user is either the owner of the document or an administrator. */
    function isOwnerOrAdmin(ownerId) {
      return isExistingOwner(ownerId) || isAdmin();
    }

    /** Validates that critical relational fields remain unchanged during an update. */
    function isUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user profiles. Users manage their own data; visibility is restricted to the owner.
     * @path /user_profiles/{userId}
     * @allow (create) if auth.uid matches {userId} and data.id matches {userId}.
     * @deny (list) if request is from a different user.
     * @principle Ownership and Path-based consistency.
     */
    match /user_profiles/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource != null && isUnchanged('id');
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description System-defined categories. Publicly readable for filtering, but restricted to admins for writes.
     * @path /categories/{categoryId}
     * @allow (list) if signed in.
     * @deny (update) if user is not an admin.
     * @principle Role-based access control (DBAC).
     */
    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    /**
     * @description System-defined tags. Publicly readable for discovery, restricted to admins for management.
     * @path /tags/{tagId}
     * @allow (get) if signed in.
     * @deny (create) if user is not an admin.
     * @principle Role-based access control (DBAC).
     */
    match /tags/{tagId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    /**
     * @description Global tool catalog. Shared visibility with owner-specific or admin-specific write controls.
     * @path /tools/{toolId}
     * @allow (create) if ownerId in data matches auth.uid.
     * @deny (delete) if user is not the owner or an admin.
     * @principle Denormalized ownership for performant authorization.
     */
    match /tools/{toolId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if resource != null && (isOwnerOrAdmin(resource.data.ownerId)) && isUnchanged('ownerId');
      allow delete: if resource != null && (isOwnerOrAdmin(resource.data.ownerId));
    }

    /**
     * @description Marker collection for admin roles. Existence of a document here grants elevated permissions.
     * @path /roles_admin/{userId}
     * @allow (get) if checking own admin status.
     * @deny (write) always (to be managed via Firebase Console or Admin SDK).
     * @principle Database Access Control (DBAC).
     */
    match /roles_admin/{userId} {
      allow get: if isOwner(userId);
      allow list: if isAdmin();
      allow create, update, delete: if false; 
    }
  }
}