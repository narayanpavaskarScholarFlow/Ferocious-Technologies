rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * TOOLROOM 2.0 SECURITY RULES (PROTOTYPING MODE)
     * 
     * Core Philosophy:
     * This ruleset implements a robust Database-Backed Access Control (DBAC) system. 
     * Security is achieved through two primary mechanisms: Path-based ownership for 
     * user-specific data and an explicit global admin role managed via the 
     * '/roles_admin' collection.
     * 
     * Data Structure:
     * - /user_profiles/{userId}: User-owned documents containing profile and role info.
     * - /tools, /categories, /tags: Global catalog data accessible to all signed-in users.
     * - /roles_admin/{userId}: A "gatekeeper" collection where the presence of a 
     *   UID grants global administrative privileges.
     * 
     * Key Security Decisions:
     * 1. Authorization Independence: Read/Write rules for global entities check the 
     *    'roles_admin' collection directly using exists(), avoiding slow lookups 
     *    to the user_profiles collection.
     * 2. Strict Admin Control: All catalog modifications (create, update, delete) 
     *    are restricted exclusively to users verified in the 'roles_admin' collection.
     * 3. Identity Verification: All operations require a valid Firebase Auth UID.
     * 
     * Denormalization for Authorization:
     * - The 'id' field is denormalized on all entities to allow for relational 
     *   integrity checks (e.g., ensuring a document's internal ID matches its path).
     * - 'addedByUserId' is stored in Tools for audit logs, though primary 
     *   authorization remains with the global Admin role.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is explicitly registered as an admin in the DBAC collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** @description Checks ownership and ensures the document exists for destructive operations. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /** @description Checks if the user is an admin and the document exists. */
    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the UserProfile collection. Users can manage their own data; Admins can manage everyone.
     * @path /user_profiles/{userId}
     * @allow (get) If request.auth.uid is 'abc' and path is /user_profiles/abc
     * @deny (list) If request.auth.uid is 'abc' and user attempts to list all profiles (unless admin).
     * @principle Enforces path-based ownership with administrative override for user management.
     */
    match /user_profiles/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isExistingOwner(userId) || isAdmin()) && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the Tool catalog. Global read access for users; write access for admins only.
     * @path /tools/{toolId}
     * @allow (get) Any authenticated user reading a tool document.
     * @deny (create) An authenticated user without an admin record in /roles_admin.
     * @principle Implements global read access with DBAC-protected write operations.
     */
    match /tools/{toolId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.id == toolId;
      allow update: if isExistingAdmin() && request.resource.data.id == resource.data.id;
      allow delete: if isExistingAdmin();
    }

    /**
     * @description Rules for tool categories. Global read access; admin-only writes.
     * @path /categories/{categoryId}
     * @allow (list) Any signed-in user browsing the category list.
     * @deny (delete) Any user who is not explicitly verified as an admin.
     * @principle Protects taxonomy integrity by restricting updates to authorized admins.
     */
    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.id == categoryId;
      allow update: if isExistingAdmin() && request.resource.data.id == resource.data.id;
      allow delete: if isExistingAdmin();
    }

    /**
     * @description Rules for tool tags. Global read access; admin-only writes.
     * @path /tags/{tagId}
     * @allow (get) Any signed-in user fetching tag details.
     * @deny (update) Any user attempting to rename a tag without admin privileges.
     * @principle Maintains global metadata consistency via admin-only write permissions.
     */
    match /tags/{tagId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.id == tagId;
      allow update: if isExistingAdmin() && request.resource.data.id == resource.data.id;
      allow delete: if isExistingAdmin();
    }

    /**
     * @description Security gate for administrative privileges. Managed primarily by system admins.
     * @path /roles_admin/{userId}
     * @allow (get) Admins checking their own or others' status.
     * @deny (create) Users attempting to grant themselves administrative rights.
     * @principle Uses an existence-based check for high-performance, atomic authorization decisions.
     */
    match /roles_admin/{userId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false; // Admin roles are managed manually or via backend functions for safety.
    }
  }
}