
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile within the Bharat Axis application.",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "email", "createdAt", "updatedAt"]
    },
    "Machine": {
      "title": "Machine",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "mcNumber": { "type": "string" },
        "make": { "type": "string" },
        "bedSize": { "type": "string" },
        "costPerHour": { "type": "number" },
        "load": { "type": "number" },
        "status": { "type": "string" },
        "image": { "type": "string" }
      }
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customer": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "owner": { "type": "string" },
        "progress": { "type": "number" },
        "amountSpent": { "type": "string" }
      }
    },
    "Customer": {
      "title": "Customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "contactNumber": { "type": "string" },
        "gstNumber": { "type": "string" },
        "contactPerson": { "type": "string" },
        "type": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "totalOrders": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "StaffMember": {
      "title": "StaffMember",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "dept": { "type": "string" },
        "status": { "type": "string" },
        "shift": { "type": "string" },
        "efficiency": { "type": "number" }
      }
    },
    "Vendor": {
      "title": "Vendor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "activeOrders": { "type": "number" },
        "rating": { "type": "number" },
        "contact": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "WorkLog": {
      "title": "WorkLog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceName": { "type": "string" },
        "operator": { "type": "string" },
        "date": { "type": "string" },
        "shift": { "type": "string" },
        "activity": { "type": "string" },
        "duration": { "type": "string" },
        "type": { "type": "string" },
        "workOrderId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/machines/{machineId}",
        "definition": {
          "entityName": "Machine",
          "description": "Inventory of industrial machines and assets."
        }
      },
      {
        "path": "/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "description": "Production and work orders ledger."
        }
      },
      {
        "path": "/customers/{customerId}",
        "definition": {
          "entityName": "Customer",
          "description": "CRM customer accounts database."
        }
      },
      {
        "path": "/staff/{staffId}",
        "definition": {
          "entityName": "StaffMember",
          "description": "HR resource and personnel directory."
        }
      },
      {
        "path": "/vendors/{vendorId}",
        "definition": {
          "entityName": "Vendor",
          "description": "Supply chain partner directory."
        }
      },
      {
        "path": "/work_logs/{logId}",
        "definition": {
          "entityName": "WorkLog",
          "description": "Daily operational activity and throughput logs."
        }
      }
    ]
  }
}
